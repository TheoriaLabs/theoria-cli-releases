{
  "name": "theoria-cli",
  "version": "0.1.0-beta.2",
  "description": "Lightweight Theoria CLI harness built on the Pi coding agent",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "theoria": "./bin/theoria.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node bin/theoria.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'packages/*/test/*.test.ts'",
    "check": "npm run typecheck && npm test",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "pi-better-render": "0.2.0",
    "pi-goal-x": "0.32.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.9.0"
  }
}
